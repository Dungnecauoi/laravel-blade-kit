{
    "name": "dungnecauoi/laravel-blade-kit",
    "description": "A lean, self-hosted admin UI kit for Laravel: Blade components (x-component syntax), Tailwind CSS v4 design tokens, and Alpine.js — no Livewire, no black-box package lock-in. Installs by copying real files into your app.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "blade", "tailwindcss", "alpinejs", "admin", "ui-kit"],
    "authors": [
        {
            "name": "Dungnecauoi"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelBladeKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelBladeKit\\BladeKitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
